<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.10240.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.10240.0</SupportedOSPlatformVersion>
    <UseUwp>true</UseUwp>
    <DisableWinExeOutputInference>true</DisableWinExeOutputInference>
    <Platforms>x86;x64;ARM;ARM64</Platforms>
    <RuntimeIdentifiers>win10-arm64;win10-x64;win10-x86</RuntimeIdentifiers>
    <DefaultLanguage>ru-RU</DefaultLanguage>
    <Nullable>disable</Nullable>
    <UseWindowsForms>false</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WindowsSdkPackageVersion" Version="10.0.17763.63" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MetroCore\MetroCore.csproj" />
  </ItemGroup>
</Project>
