<Page
    x:Class="MetroModern.Uwp.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MetroModern.Uwp"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Command bar -->
        <CommandBar Grid.Row="0" Background="#FF2C2C2C">
            <CommandBar.Content>
                <StackPanel Orientation="Horizontal" Padding="10,0" VerticalAlignment="Center">
                    <TextBlock x:Name="CityTitle" Text="Метро" FontWeight="SemiBold" FontSize="18"
                               Foreground="White" Margin="0,0,16,0"/>
                    <ComboBox x:Name="CityPicker" SelectionChanged="CityPicker_SelectionChanged"
                              Width="170" PlaceholderText="Город" Foreground="White">
                        <ComboBoxItem Content="Санкт-Петербург"/>
                        <ComboBoxItem Content="Москва"/>
                    </ComboBox>
                </StackPanel>
            </CommandBar.Content>
            <AppBarButton Icon="Direction" Label="Маршрут" Click="OnRouteClick"/>
            <AppBarButton Icon="ClearSelection" Label="Сброс" Click="OnClearClick"/>
            <AppBarButton Icon="Refresh" Label="Обновить" Click="OnRefreshClick"/>
        </CommandBar>

        <!-- Map viewport with pan/zoom -->
        <Grid Grid.Row="1" x:Name="MapHost" Background="#FFFAFAFA"
              PointerWheelChanged="MapHost_PointerWheelChanged">
            <Canvas x:Name="MapCanvas" ManipulationMode="TranslationLockYAxis" Background="Transparent"
                    ManipulationDelta="MapCanvas_ManipulationDelta">
                <Canvas.RenderTransform>
                    <CompositeTransform x:Name="MapTransform" ScaleX="1" ScaleY="1"
                                        CenterX="140" CenterY="180"/>
                </Canvas.RenderTransform>
            </Canvas>

            <!-- Route result overlay -->
            <Border x:Name="RoutePanel" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,10,10" Background="#CCFFFFFF" BorderBrush="#FFBBBBBB" BorderThickness="1"
                    CornerRadius="2" Visibility="Collapsed" MaxHeight="240">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="RouteList" Padding="10" MinWidth="220" MaxWidth="320"/>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Grid Grid.Row="2" Background="#FF2C2C2C">
            <TextBlock x:Name="Status" Text="Готов к работе" Foreground="White" Padding="10,4"/>
        </Grid>
    </Grid>
</Page>
